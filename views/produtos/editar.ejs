<h1>Editar produto</h1>

<form action="/produtos/<%= produto.id %>" method="POST">

    <label>Nome:</label>
    <input
        type="text"
        name="nome"
        value="<%= produto.nome %>"
        required
    >

    <br>

    <label>Preço:</label>
    <input
        type="number"
        name="preco"
        step="0.01"
        value="<%= produto.preco %>"
        required
    >

    <br>

    <label>Quantidade:</label>
    <input
        type="number"
        name="quantidade"
        value="<%= produto.quantidade %>"
    >

    <br>

    <button type="submit">
        Atualizar
    </button>

</form>

<a href="/produtos">Voltar</a>
