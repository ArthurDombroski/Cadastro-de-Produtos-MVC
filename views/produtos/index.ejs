<h1>Produtos</h1>

<a href="/produtos/novo">Novo produto</a> |
<a href="/categorias">Categorias</a>

<form action="/produtos" method="GET">
    <label>Pesquisar:</label>
    <input type="text" name="busca" value="<%= busca %>">

    <button type="submit">
        Buscar
    </button>

    <% if (busca) { %>
        <a href="/produtos">Limpar</a>
    <% } %>
</form>

<% if (busca) { %>
    <p><%= produtos.length %> produto(s) encontrado(s) para "<%= busca %>".</p>
<% } %>

<table border="1">
    <tr>
        <th>Nome</th>
        <th>Preço</th>
        <th>Quantidade</th>
        <th>Categoria</th>
        <th>Ações</th>
    </tr>

    <% produtos.forEach(p => { %>

        <tr>
            <td><%= p.nome %></td>
            <td><%= p.preco %></td>
            <td><%= p.quantidade %></td>
            <td>
                <% if (p.categoria) { %>
                    <a href="/produtos/categoria/<%= p.categoria.id %>">
                        <%= p.categoria.nome %>
                    </a>
                <% } else { %>
                    Sem categoria
                <% } %>
            </td>

            <td>
                <a href="/produtos/<%= p.id %>/editar">
                    Editar
                </a>

                <form
                    action="/produtos/<%= p.id %>/deletar"
                    method="POST"
                    style="display:inline"
                >
                    <button type="submit">
                        Excluir
                    </button>
                </form>
            </td>
        </tr>

    <% }) %>

</table>
