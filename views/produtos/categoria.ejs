<h1>Categoria: <%= categoria.nome %></h1>

<a href="/produtos">Todos os produtos</a> |
<a href="/categorias">Categorias</a>

<% if (produtos.length === 0) { %>

    <p>Nenhum produto cadastrado nesta categoria.</p>

<% } else { %>

    <table border="1">
        <tr>
            <th>Nome</th>
            <th>Preço</th>
            <th>Quantidade</th>
        </tr>

        <% produtos.forEach(p => { %>

            <tr>
                <td><%= p.nome %></td>
                <td><%= p.preco %></td>
                <td><%= p.quantidade %></td>
            </tr>

        <% }) %>

    </table>

<% } %>
